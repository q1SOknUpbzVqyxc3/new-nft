VITE_API_BASE_URL=
# Optional: company support link (e.g. https://t.me/...). Support CTAs render only when set.
VITE_SUPPORT_URL=
# Optional: overrides the brand derived from the hostname (one build serves many mirror domains).
VITE_BRAND_NAME=
# Optional legal document links (https:// or same-origin path). Unset links are not rendered; terms falls back to the Monvravex agreement.
VITE_TERMS_URL=
VITE_PRIVACY_URL=
VITE_COOKIE_URL=
# Optional: set to "off" to hide the NFT news block on the dashboard.
VITE_NEWS_WIDGET=
# Preview only: set to 1 to show sample events in the activity feed until the backend ships /api/activity-feed. Never enable in production.
VITE_ACTIVITY_DEMO=
